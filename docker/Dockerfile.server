# Multi-stage lightweight production image for NetSentry v2 FastAPI Gateway & Serving Server
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=8000 \
    PYTHONPATH=/app

WORKDIR /app

# Install system dependencies (curl for healthcheck, libgomp1 for LightGBM/XGBoost C++ bindings)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# Install Python requirements
COPY docker/requirements.serving.txt requirements.txt
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Copy application code and configurations
COPY netsentry/ ./netsentry/
COPY configs/ ./configs/

# Expose gateway / serving port
EXPOSE 8000

# Health check against NetSentry health route
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Start Uvicorn ASGI server running NetSentry v2 serving application
CMD ["uvicorn", "netsentry.serving.app:app", "--host", "0.0.0.0", "--port", "8000"]
